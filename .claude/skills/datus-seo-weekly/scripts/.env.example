# Copy to ~/.datus-seo-weekly/.env (outside the repo — Datus-website is public).
# Never commit a filled-in copy of this file.

# ── GSC (required) ──
GSC_SITE_URL=https://datus.ai/
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# final = settled data only (lags 2-3 days); all = include fresh data
# GSC_DATA_STATE=final

# ── GA4 (recommended; behaviour / conversion sections) ──
GA4_PROPERTY_ID=
# Leave these empty to reuse the GSC service account
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# ── Report week end (YYYY-MM-DD, a Sunday; default = last Sunday) ──
# REPORT_WEEK_END=2026-09-20
